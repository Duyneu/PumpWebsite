{
  "name": "voltor-backend",
  "version": "1.0.0",
  "description": "VOLTOR Vietnam Backend API with MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "mysql -u root -p voltor_db < ../database/schema.sql",
    "seed-db": "mysql -u root -p voltor_db < ../database/seed.sql"
  },
  "keywords": ["api", "mysql", "express", "voltor"],
  "author": "VOLTOR Vietnam",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.1.5",
    "node-cache": "^5.1.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}