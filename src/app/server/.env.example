# Server Port
PORT=3001
NODE_ENV=development

# Option 1: PostgreSQL Connection URL (e.g. Supabase, Neon, Railway, Render, Local)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voltor_db
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Option 2: Individual PostgreSQL Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=voltor_db
DB_SSL=false

# Authentication
JWT_SECRET=voltor-secret-key-change-in-production-2026

